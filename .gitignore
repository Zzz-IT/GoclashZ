# ---- Wails v3 / Go / frontend ----

# wails3 build output (v3 writes the binary to <root>/bin/GoclashZ.exe)
/bin/
# v2 output directory, kept ignored so stale artefacts never sneak in
build/bin/

frontend/dist/
# generated by `wails3 generate bindings` (wails3 task bindings / common:generate:bindings)
frontend/bindings/
# v2 generated bindings, removed by the v3 migration
frontend/wailsjs/

node_modules/
*.exe
*.syso
*.log

# task runner cache (go-task / wails3 task)
.task/
.taskfiles/

# ---- Local data & logs ----
/data/*
!/data/core/
!/data/core/bin/
!/data/core/bin/*
data/core/bin/*.tmp
data/core/bin/*.db
data/core/bin/*.zip
data/core/bin/*.meta.json

# ---- IDEs ----
.idea/
.vscode/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Build artefacts ----
build/installer/
build/portable/
build/windows/nsis/*.exe
build/windows/installer/tmp/
build/release_notes.md
*.msi
*.msix

# ---- Temp / misc ----
webfonts/
scratch/

# ---- Local scratch (never publish) ----
# 调试截图与探针脚本、编辑前的源码备份、本地 agent 配置都不进仓库
.probe/
.fixbackup/
.mimocode/

# Stray session-export dumps accidentally dropped into the repo root.
# (wails.json is gone in v3; add a "!" rule here if a root JSON file must be tracked.)
/*.json
