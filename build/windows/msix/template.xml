<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="goclashz.exe"
        Arguments=""
        InstallLocation="C:\Program Files\ZzzDREAM\GoclashZ">
    </Installer>
    <PackageInformation
        PackageName="GoclashZ"
        PackageDisplayName="GoclashZ"
        PublisherName="CN=ZzzDREAM"
        PublisherDisplayName="ZzzDREAM"
        Version="1.4.0.0"
        PackageDescription="A modern Clash client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.zzzdream.goclashz"
                Description="A modern Clash client"
                DisplayName="GoclashZ"
                ExecutableName="goclashz.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>GoclashZ</DisplayName>
            <PublisherDisplayName>ZzzDREAM</PublisherDisplayName>
            <Description>A modern Clash client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="goclashz.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
